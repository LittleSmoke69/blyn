# O front NUNCA aponta direto pro host do Supabase — sempre pro gateway
# (supabase/functions/gateway), que injeta a apikey real no servidor.
# Em produção, isso passa pelo domínio da aplicação via proxy reverso
# (ex: https://app.blyn.com.br/api/gateway); em dev local, aponta direto
# pro gateway rodando no Supabase local.
VITE_GATEWAY_URL=http://127.0.0.1:54321/functions/v1/gateway
